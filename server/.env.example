# Copy this file to ".env" and fill in your own values. NEVER commit ".env".

# Port the API listens on (Render sets this automatically in production)
PORT=5000

# MongoDB Atlas connection string. Replace <username>, <password>, <cluster>.
# The "/finora" part is the database name.
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/finora?retryWrites=true&w=majority

# Long random string used to sign JWTs. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Allowed frontend origin(s) for CORS. Comma-separated, no trailing slash.
# Local:       http://localhost:5173
# Production:  https://your-app.vercel.app
CLIENT_URL=http://localhost:5173
